# SmartPrint Configuration

# Admin identity — hardcoded for single shop
ADMIN_ID=smartprint_shop_001

# Secret path for admin access (e.g., /admin/printshop2024)
ADMIN_SECRET_PATH=printshop2024

# Base URL of the deployment
BASE_URL=http://localhost:3000

# Public vars (accessible from browser — needed for QR code)
NEXT_PUBLIC_ADMIN_ID=smartprint_shop_001
NEXT_PUBLIC_BASE_URL=http://localhost:3000
