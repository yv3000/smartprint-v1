
{
  "name": "smartprint-admin",
  "version": "1.1.0",
  "description": "SmartPrint Admin Panel Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.smartprint.admin",
    "productName": "SmartPrint Admin",
    "protocols": {
      "name": "SmartPrint Auth",
      "schemes": ["smartprint"]
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "identity": null
    }
  }
}
